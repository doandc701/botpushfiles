# Token lấy từ @BotFather
BOT_TOKEN=123456:ABC-xyz

# Nơi bot upload file đến (channel/group). Bot phải là admin của channel.
# Ví dụ: -1001234567890 hoặc @ten_channel. Để trống = gửi lại vào chính chat với bot.
TARGET_CHAT_ID=

# Chỉ cho phép các user ID này dùng bot (cách nhau bởi dấu phẩy). Gõ /start để xem ID của bạn.
ALLOWED_USER_IDS=

# Tuỳ chọn: Local Bot API server để upload file tới 2000 MB (mặc định giới hạn 50 MB)
# api_id / api_hash lấy tại https://my.telegram.org -> API development tools. Chạy server: ./run_bot_api.sh
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_BOT_API_URL=
MAX_SIZE_MB=

# Có TELEGRAM_API_ID / TELEGRAM_API_HASH thì bot upload qua MTProto: có % tiến trình upload thật, file tới 2000 MB
# (không cần Local Bot API server). Đặt 0 để upload qua Bot API như cũ (chỉ hiện thời gian).
MTPROTO_UPLOAD=1

# Tuỳ chọn: proxy để tải (khi mạng chặn TikTok/YouTube...), vd http://host:8080 hoặc socks5://host:1080
PROXY=
